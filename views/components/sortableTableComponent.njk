{#
  Sortable Table Component

  A reusable component for creating sortable tables based on MOJ Design System.

  Features:
  - Built on govukTable for consistency and accessibility
  - Server-side sorting with URL-based navigation
  - Custom CSS classes for table, headers, cells, and links
  - Clickable links in table cells with dynamic placeholders
  - Full accessibility compliance with aria-sort attributes

  Usage:
  {% from "components/sortableTableComponent.njk" import sortableTableComponent %}

  {{ sortableTableComponent({
    id: "cases-table",
    caption: "New cases",
    classes: "custom-table-class",
    data: casesData,
    columns: [
      {
        key: "fullName",
        text: "Full Name",
        link: "/cases/{{caseReference}}/details",
        linkClasses: "govuk-link--no-visited-state",
        cellClasses: "custom-cell-class"
      },
      {
        key: "caseReference",
        text: "Case Reference",
        classes: "custom-header-class",
        cellClasses: "govuk-table__cell--numeric"
      },
      {
        key: "provider_assigned_at",
        text: "Date Received",
        sortable: true,
        classes: "govuk-table__header--numeric",
        cellClasses: "govuk-table__cell--numeric"
      }
    ],
    sortBy: "provider_assigned_at",
    sortOrder: "asc",
    basePath: "/cases/new"
  }) }}

  Options:
  - id: Table element ID
  - caption: Optional table caption
  - classes: CSS classes for the table element
  - data: Array of data objects
  - columns: Array of column definitions with:
    * key: Data property key
    * text: Column header text
    * sortable: Boolean for sortable columns
    * classes: CSS classes for header <th>
    * cellClasses: CSS classes for body <td>
    * link: URL pattern with placeholders ({{caseReference}}, {{fullName}}, {{id}})
    * linkClasses: CSS classes for links
    * linkKey: Custom property for {{id}} placeholder (defaults to 'id')
    * type: "stacked" combines several row properties into one cell, rendered as
      a primary linked line followed by small "label: value" lines, where the
      label is grey and the value is black. Use with:
      - primary: { key, link, linkClasses } for the top line (optional)
      - fields: [{ key, label }] for the label:value lines underneath
  - sortBy: Current sort column
  - sortOrder: Current sort order ('asc' or 'desc')
  - basePath: Base URL for sort links
#}

{%- from "govuk/components/table/macro.njk" import govukTable -%}
{% from "components/caseFlagComponent.njk" import caseFlagComponent %}

{% macro sortableTableComponent(options) %}
  {# Build the head array for govukTable #}
  {% set tableHead = [] %}
  {% for column in options.columns %}
    {% if column.sortable %}
      {# Calculate next sort order for sortable columns #}
      {% set nextSortOrder = 'desc' if (options.sortBy == column.key and options.sortOrder == 'asc') 
        else 
          'asc' %}
      {# Build ordering parameter based on sort direction #}
      {% if nextSortOrder == 'desc' %}
        {% set orderingParam = '-' + column.key %}
      {% else %}
        {% set orderingParam = column.key %}
      {% endif %}

      {% set sortUrl = options.basePath + '?ordering=' + orderingParam %}

      {# Preserve search parameters if they exist #}
      {% if options.searchKeyword %}
        {% set sortUrl = sortUrl + '&searchKeyword=' + (options.searchKeyword | urlencode) %}
      {% endif %}
      {% if options.statusSelect %}
        {% set sortUrl = sortUrl + '&statusSelect=' + (options.statusSelect | urlencode) %}
      {% endif %}

      {# Create sortable header with link #}
      {% set headerHtml %}
      <a href="{{ sortUrl }}" class="govuk-link govuk-link--no-underline govuk-link--no-visited-state{% if column.linkClasses %} {{ column.linkClasses }}{% endif %}">{{ column.text }}</a>
      {% endset %}

      {# Calculate aria-sort value #}
      {% if options.sortBy == column.key and options.sortOrder == 'asc' %}
        {% set ariaSortValue = "ascending" %}
      {% elif options.sortBy == column.key and options.sortOrder == 'desc' %}
        {% set ariaSortValue = "descending" %}
      {% else %}
        {% set ariaSortValue = "none" %}
      {% endif %}

      {% set headerItem = {
        html: headerHtml,
        classes: column.classes,
        attributes: {
          "data-sort": column.key,
          "aria-sort": ariaSortValue
        }
      } %}
    {% else %}
      {# Non-sortable header #}
      {% set headerItem = {
        text: column.text,
        classes: column.classes
      } %}
    {% endif %}
    {% set tableHead = (tableHead.push(headerItem), tableHead) %}
  {% endfor %}

  {# Build the rows array for govukTable #}
  {% set tableRows = [] %}
  {% for row in options.data %}
    {% set tableRow = [] %}
    {% for column in options.columns %}
      {# Format cell content based on column type #}
      {% set cellContent %}
        {% if column.type == "stacked" %}
          {% if column.primary %}
            {% set primaryValue = row[column.primary.key] %}
            {% if column.primary.link %}
              {% set primaryUrl = column
                .primary
                .link
                .replace('{{caseReference}}', row.caseReference)
                .replace('{{fullName}}', row.fullName) %}
              <div class="sortable-table-layout__stacked-primary"><a href="{{ primaryUrl }}" class="govuk-link{% if column.primary.linkClasses %} {{ column.primary.linkClasses }}{% endif %}">{{ primaryValue }}</a></div>
            {% else %}
              <div class="sortable-table-layout__stacked-primary">{{ primaryValue }}</div>
            {% endif %}
          {% endif %}
          {% set labelClasses = "sortable-table-layout__cell-label--secondary" %}
          {% set valueClasses = "sortable-table-layout__stacked-value" %}
          {% for field in column.fields %}
            {% set fieldValueHtml %}
              {% if field.key == "phoneNumber" and not row.safeToCall %}
                <span class="{{ valueClasses }}">{{ t('components.table.notSafeToCall') }}</span>
              {% elif row[field.key] %}
                <span class="{{ valueClasses }}">{{ row[field.key] }}</span>
              {% else %}
                <span class="{{ valueClasses }}">{{ t('components.table.notProvided') }}</span> <span class="govuk-visually-hidden">{{ t('components.table.noData') }}</span>
              {% endif %}
            {% endset %}
            <div class="govuk-body-s sortable-table-layout__stacked-line"><span class="{{ labelClasses }}">{{ field.label }}:</span> {{ fieldValueHtml | trim | safe }}</div>
          {% endfor %}
        {% elif column.key == "case_flags" %}
          <div class="stack-case-flags">
            {{ caseFlagComponent(
              row.isUrgent,
              row.vulnerableUser,
              row.outcome_code,
              row.caseStatus | lower,
              row.thirdpartyDetails,
              row.language,
              row.textRelay,
              row.bslWebcam,
              false
            ) }}
          </div>
        {% else %}
          {% if row[column.key] %}
            {{ row[column.key] | safe }}
          {% else %}
            {{ t('components.table.notProvided') }}
            <span class="govuk-visually-hidden">{{ t('components.table.noData') }}</span>
          {% endif %}
        {% endif %}
      {% endset %}

      {# Create cell with or without link (stacked columns render their own link inline) #}
      {% if column.link and column.type != "stacked" %}
        {% set linkUrl = column
          .link
          .replace('{{id}}', row[column.linkKey or 'id'])
          .replace('{{caseReference}}', row.caseReference)
          .replace('{{fullName}}', row.fullName) %}
        {% set cellHtml %}
        <a href="{{ linkUrl }}" class="govuk-link{% if column.linkClasses %} {{ column.linkClasses }}{% endif %}">{{ cellContent | trim }}</a>
        {% endset %}
        {% set cellItem = {
          html: cellHtml,
          classes: column.cellClasses
        } %}
      {% else %}
        {% set cellItem = {
          html: cellContent | trim,
          classes: column.cellClasses
        } %}
      {% endif %}

      {% set tableRow = (tableRow.push(cellItem), tableRow) %}
    {% endfor %}
    {% set tableRows = (tableRows.push(tableRow), tableRows) %}
  {% endfor %}

  {# Render the GOV.UK table with our data #}
  <div class="sortable-table-layout__container">
    {{ govukTable({
      caption: options.caption,
      classes: options.classes,
      attributes: {
        id: options.id
      },
      head: tableHead,
      rows: tableRows
    }) }}
  </div>
{% endmacro %}