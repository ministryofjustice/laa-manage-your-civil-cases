{% extends "base.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageTitle %}
  {% if errorState.hasErrors %}{{ t('common.error') }}: {% endif %}{{ t('pages.caseDetails.legalHelpForm.pageTitle', { caseReference: caseReference, serviceName: config.SERVICE_NAME }) }}
{% endblock %}

{% block backLink %}
  <div class="govuk-button-group">
    {{ govukBackLink({
        text: t('common.back'),
        href: "/cases/" + caseReference + "/get-legal-help-form",
        classes: "govuk-!-margin-bottom-0 govuk-!-margin-right-4 govuk-!-display-none-print"
      }) }}

    {# Print button top #}
    <div class="printing-button">
      <div class="govuk-!-display-none-print  govuk-!-margin-top-2 govuk-!-margin-bottom-0">
        <button id="printButton" class="govuk-link govuk-body-s print-link">{{ t('pages.caseDetails.legalHelpForm.printThisPage') }}</button>
      </div>
    </div>
  </div>
{% endblock %}

{% block pageContent %}
  <hr class="horizontal-line-top"/>
  <div class="govuk-grid-row legal-help-form-pdf-width">
    <div class="govuk-grid-column-two-thirds">
      {# Introduction #}
      {% include "case_details/legal_help_form/_legal-help-form-intro.njk" %}

      {# Your details #}
      {% include "case_details/legal_help_form/_legal-help-form-details.njk" %}

      {% if not legalHelpExtract.hasPassportedProceedingsLetter %}
        {# Your finances #}
        {% include "case_details/legal_help_form/_legal-help-form-finances.njk" %}

        {% if not legalHelpExtract.under18passportedBenefits %}
          {# Your property #}
          {% include "case_details/legal_help_form/_legal-help-form-property.njk" %}

          {# Your capital #}
          {% include "case_details/legal_help_form/_legal-help-form-capital.njk" %}

          {# Your income #}
          {% include "case_details/legal_help_form/_legal-help-form-income.njk" %}
        {% endif %}
      {% endif %}

      {# Evidence we need from you #}
      {% include "case_details/legal_help_form/_legal-help-form-evidence.njk" %}

      {# Your declaration #}
      {% include "case_details/legal_help_form/_legal-help-form-declaration.njk" %}

      {# Privacy notice #}
      {% include "case_details/legal_help_form/_legal-help-form-privacy.njk" %}

      {# For use by advisor #}
      {% include "case_details/legal_help_form/_legal-help-form-advisor.njk" %}
    </div>
  </div>

  <hr class="horizontal-line-bottom"/>

  <div class="govuk-button-group bottom-button-group">
    <p>
      <a class="govuk-link govuk-!-display-none-print" href="#">{{ t('pages.caseDetails.legalHelpForm.jumpToTop') }}</a>
    </p>

    {# Print button bottom #}
    <div class="printing-button">
      <div class="govuk-!-display-none-print govuk-!-margin-top-3 govuk-!-margin-bottom-0">
        <button id="printButton" class="govuk-link govuk-body-s print-link">{{ t('pages.caseDetails.legalHelpForm.printThisPage') }}</button>
      </div>
    </div>
  </div>
{% endblock %}