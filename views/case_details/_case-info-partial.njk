{% from "govuk/components/button/macro.njk" import govukButton %}
{%- from "moj/components/button-menu/macro.njk" import mojButtonMenu -%}
{% from "components/caseFlagComponent.njk" import caseFlagComponent %}

{% set statusConfig = {
  "new": { text: t('common.status.new') },
  "pending": { text: t('common.status.pending') },
  "advising": { text: t('common.status.advising') },
  "closed": { text: t('common.status.closed') },
  "completed": { text: t('common.status.completed') }
} %}

{% set currentStatus = client.caseStatus %}

{# Case state change button logic #}
{% if currentStatus == "new" %}
  {% set menuItemsForStatus = [
    {
      text: t('pages.caseDetails.buttons.actions.advising'),
      href: "/cases/" + client.caseReference + "/accept",
      attributes: {
        "data-method": "post"
      }
    }, {
      text: t('pages.caseDetails.buttons.actions.pending'),
      href: "/cases/" + client.caseReference + "/why-pending"
    }, {
      text: t('pages.caseDetails.buttons.actions.closed'),
      href: "/cases/" + client.caseReference + "/why-closed"
    }
  ] %}
{% elif currentStatus == "pending" %}
  {% set menuItemsForStatus = [
    {
      text: t('pages.caseDetails.buttons.actions.advising'),
      href: "/cases/" + client.caseReference + "/accept",
      attributes: {
        "data-method": "post"
      }
    }, {
      text: t('pages.caseDetails.buttons.actions.closed'),
      href: "/cases/" + client.caseReference + "/why-closed"
    }
  ] %}
{% elif currentStatus == "advising" %}
  {# Empty hidden menu item to fix the issue: MOJ Button Menu component hides the dropdown when there's only one item #}
  {% set menuItemsForStatus = [
    {
      text: t('pages.caseDetails.buttons.actions.completed'),
      href: "/cases/" + client.caseReference + "/completed",
      attributes: {
        "data-method": "post"
      }
    }, {
      text: '',
      classes: 'govuk-visually-hidden'
    }
  ] %}
{% elif currentStatus == "closed" %}
  {% set menuItemsForStatus = [
    {
      text: t('pages.caseDetails.buttons.actions.advising'),
      href: "/cases/" + client.caseReference + "/why-reopen-closed-case"
    }, {
      text: '',
      classes: 'govuk-visually-hidden'
    }
  ] %}
{% elif currentStatus == "completed" %}
  {% set menuItemsForStatus = [
    {
      text: t('pages.caseDetails.buttons.actions.advising'),
      href: "/cases/" + client.caseReference + "/why-reopen-completed-case"
    }, {
      text: '',
      classes: 'govuk-visually-hidden'
    }
  ] %}
{% endif %}


{% set menuItemsForActions = [
  {
    text: t('pages.caseDetails.buttons.splitThisCase'),
    href: "/cases/" + client.caseReference + "/split-this-case",
    classes: "split-case-button govuk-button--secondary"
  }, {
    text: t('pages.caseDetails.buttons.giveOperatorFeedback'),
    href: "/cases/" + client.caseReference + "/give-operator-feedback",
    classes: "govuk-button--secondary"
  }, {
    text: t('pages.caseDetails.buttons.generateLegalHelpForm'),
    href: "/cases/" + client.caseReference + "/get-legal-help-form",
    classes: "govuk-button--secondary"
  }
] %}

<div class="govuk-grid-row negative-margin mcc-case-details-light-blue-container">
  <div class="govuk-grid-column-full">
    {# Case flags #}
    <div class="case-flags">
      {% set supportNeeds = client.clientSupportNeeds %}
      {% set isUrgent = client.is_urgent == "true" %}
      {% set vulnerableUser = client.vulnerableUser %}
      {% set outcomeCode = client.outcome_code %}
      {% set caseStatus = client.caseStatus | lower %}
      {% set thirdParty = client.thirdParty and not client.thirdParty.isSoftDeleted and client.thirdParty %}
      {% set language = supportNeeds and supportNeeds.languageSupportNeeds %}
      {% set textRelay = supportNeeds and supportNeeds.textRelay == "Yes" %}
      {% set bslWebcam = supportNeeds and supportNeeds.bslWebcam == "Yes" %}

      {{ caseFlagComponent(
        isUrgent,
        vulnerableUser,
        outcomeCode,
        caseStatus,
        thirdParty,
        language,
        textRelay,
        bslWebcam,
        true
      ) }}
    </div>

    <div class="mcc-case-details-dark-blue-container mcc-case-details-header">
      {# Name #}
      <h1 class="govuk-heading-xl">{{ client.fullName }}</h1>
      {# LAA reference #}
      <h2 class="govuk-heading-s govuk-!-font-size-16">{{ t('pages.caseDetails.laaReference') }}<br><p class="govuk-body">{{ client.laaReference }}</p></h2>
      {# Case reference #}
      <h2 class="govuk-heading-s govuk-!-font-size-16">{{ t('pages.caseDetails.caseReference') }}<br><p class="govuk-body">{{ client.caseReference }}</p></h2>
      {# Date received #}
      <h2 class="govuk-heading-s govuk-!-font-size-16">{{ t('pages.caseDetails.dateReceived') }}<br><p class="govuk-body">{{ client.provider_assigned_at }}</p></h2>
      {# Date of birth #}
      <h2 class="govuk-heading-s govuk-!-font-size-16">{{ t('pages.caseDetails.dateOfBirth') }}<br><p class="govuk-body">{{ client.dateOfBirth }} (55)</p></h2>
    </div>
    
    <div class="case-status-label-and-button-container">
      {# Status #}
      <h2 class="govuk-heading-s case-status-heading">{{ t('pages.caseDetails.status') }}:
        <span class="govuk-body">{{ statusConfig[currentStatus].text }}</span>
      </h2>
      {# Menu buttons #}
      {% if not hideStatusButton %}
        {{ mojButtonMenu({
          id: "change-case-status-menu",
          button: {
            text: t('pages.caseDetails.buttons.label')
          },
          preventDoubleClick: true,
          items: menuItemsForStatus
        }) }}

        {{ mojButtonMenu({
          id: "case-actions-menu",
          button: {
            text: t('pages.caseDetails.buttons.labelAction'),
            classes: "govuk-button--secondary"
          },
          preventDoubleClick: true,
          items: menuItemsForActions
        }) }}
      {% endif %}
    </div>
  </div>
</div>

{% if addPaddingOnBottom %}
  <div class="govuk-!-padding-bottom-6"></div>
{% endif %}