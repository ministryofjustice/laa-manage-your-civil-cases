{% extends "case_details/_base-case-change.njk" %}

{% block pageTitle %}{{ t('pages.caseDetails.legalHelpForm.pageTitle', { caseReference: caseReference, serviceName: config.SERVICE_NAME }) }}{% endblock %}

{% block errorSummaryOrAlert %}{% endblock %}

{% block formContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-m">{{ t('pages.caseDetails.legalHelpForm.heading') }}</h2>

      {% if evidence %}
        <h3 class="govuk-heading-s">{{ t('pages.caseDetails.getLegalHelpForm.evidenceLabel') }}</h3>
        <p class="govuk-body">{{ evidence | escape | replace('\n', '<br>') | safe }}</p>
      {% endif %}

      {% if additionalCircumstances.length %}
        <h3 class="govuk-heading-s">{{ t('pages.caseDetails.getLegalHelpForm.additionalCircumstancesLegend') }}</h3>
        <ul class="govuk-list govuk-list--bullet">
          {% for label in additionalCircumstances %}
            <li>{{ label }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endblock %}
