{% from "components/summaryCardComponent.njk" import summaryCardComponent %}

{% set changePropertiesLink = "/cases/" + caseReference + "/financial-eligibility/change/client-partner-properties" if financialEligibility.hasPartner else "/cases/" + caseReference + "/financial-eligibility/change/properties" %}
{% set isDisputedCategory = financialEligibility.category == 'debt' or financialEligibility.category == 'family' %}

{% if financialEligibility.propertySet and financialEligibility.propertySet.length %}
  {% for property in financialEligibility.propertySet %}
    {% set constructedData = {
      value: property.value | formatFinancialData,
      mortgageLeft: property.mortgageLeft | formatFinancialData,
      mainProperty: "Yes" if property.main else "No",
      partnerPropertyShare: property.share + "%",
      disputed: "Yes" if property.disputed else "No"
    } %}

    {# Loop function will only work up to 22nd property - it is assumed if a client has 22 properties they are likely ineligible for support #}
    <h3 class="govuk-heading-s">
      {% if loop.index == 1 %}
        {% set title = "1st property" %}
      {% elseif loop.index == 2 %}
        {% set title = "2nd property" %}
      {% elseif loop.index == 3 %}
        {% set title = "3rd property" %}
      {% else %}
        {% set title = loop.index ~ "th property" %}
      {% endif %}
    </h3>

    {% set propertyRows = [
      {
        label: t("common.financialEligibility.finances.propertyValue"),
        key: 'value'
      },
      {
        label: t("common.financialEligibility.finances.mortgageLeft"),
        key: 'mortgageLeft'
      },
      {
        label: t("common.financialEligibility.finances.mainProperty"),
        key: 'mainProperty'
      },
      {
        label: t("common.financialEligibility.finances.partnerPropertyShare") if financialEligibility.hasPartner else t("common.financialEligibility.finances.propertyShare"),
        key: 'partnerPropertyShare'
      }
    ] %}
    
    {% if isDisputedCategory %}
      {% set propertyRows = propertyRows.concat([
        {
          label: t("common.financialEligibility.finances.disputedProperty"),
          key: 'disputed'
        }
      ]) %}
    {% endif %}

    {{ summaryCardComponent({
      classes: "eligibility-table",
      data: constructedData,
      card: {
        title: {
          text: title
        },
        actions: {
          items: [
            {
              href: changePropertiesLink,
              text: t("common.change")
            }
          ]
        }
      },
      rows: propertyRows
    }) }}
  {% endfor %}
{% else %}
  {{ summaryCardComponent({
    classes: "eligibility-table",
    data: {noPropertiesText: t("common.none")},
    card: {
      title: {
        text: t("common.financialEligibility.finances.propertiesHeading")
      },
      actions: {
        items: [
          {
            href: changePropertiesLink,
            text: t("common.change")
          }
        ]
      }
    },
    rows: [
      {
        label: t("common.financialEligibility.finances.propertiesAdded"),
        key: "noPropertiesText"
      }
    ]
  }) }}
{% endif %}

{% set savingsHeading = t("common.financialEligibility.finances.undisputedSavings") if isDisputedCategory else t("common.financialEligibility.finances.yourSavings") %}

{% set savings = financialEligibility.clientData.savings %}
{% set savingsData = {
  bankBalance: savings.bankBalance | formatFinancialData,
  investmentBalance: savings.investmentBalance | formatFinancialData,
  assetBalance: savings.assetBalance | formatFinancialData,
  creditBalance: savings.creditBalance | formatFinancialData
} %}

{{ summaryCardComponent({
    classes: "eligibility-table",
    data: savingsData,
    card: {
      title: {
        text: savingsHeading
      },
      actions: {
        items: [
          {
            href: "/cases/" + caseReference + "/financial-eligibility/change/your-savings",
            text: t('common.change')
          }
        ]
      }
    },
    rows: [
      {
        label: t("common.financialEligibility.finances.savingsBalance"),
        key: 'bankBalance'
      },
      {
        label: t("common.financialEligibility.finances.investmentBalance"),
        key: 'investmentBalance'
      },
      {
        label: t("common.financialEligibility.finances.assetBalance"),
        key: 'assetBalance'
      },
      {
        label: t("common.financialEligibility.finances.creditBalance"),
        key: 'creditBalance'
      }
    ]
  }) }}

{% if financialEligibility.hasPartner %}
  {% set partnerSavingsHeading = t("common.financialEligibility.finances.undisputedPartnerSavings") if isDisputedCategory else t("common.financialEligibility.finances.partnerSavings") %}
  {% set partnerSavings = financialEligibility.partnerData.partnerSavings %}
  {% set partnerSavingsData = {
    bankBalance: partnerSavings.bankBalance | formatFinancialData,
    investmentBalance: partnerSavings.investmentBalance | formatFinancialData,
    assetBalance: partnerSavings.assetBalance | formatFinancialData,
    creditBalance: partnerSavings.creditBalance | formatFinancialData
  } %}

  {{ summaryCardComponent({
    classes: "eligibility-table",
    data: partnerSavingsData,
    card: {
      title: {
        text: partnerSavingsHeading
      },
      actions: {
        items: [
          {
            href: "/cases/" + caseReference + "/financial-eligibility/change/partner-savings",
            text: t('common.change')
          }
        ]
      }
    },
    rows: [
      {
        label: t("common.financialEligibility.finances.partnerSavingsBalance"),
        key: 'bankBalance'
      },
      {
        label: t("common.financialEligibility.finances.partnerInvestmentBalance"),
        key: 'investmentBalance'
      },
      {
        label: t("common.financialEligibility.finances.partnerAssetBalance"),
        key: 'assetBalance'
      },
      {
        label: t("common.financialEligibility.finances.partnerCreditBalance"),
        key: 'creditBalance'
      }
    ]
  }) }}
{% endif %}

{% if isDisputedCategory %}
  {% set disputedSavings = financialEligibility.disputedSavings %}
  {% set disputedSavingsData = {
    bankBalance: disputedSavings.bankBalance | formatFinancialData,
    investmentBalance: disputedSavings.investmentBalance | formatFinancialData,
    assetBalance: disputedSavings.assetBalance | formatFinancialData,
    creditBalance: disputedSavings.creditBalance | formatFinancialData
  } %}

  {{ summaryCardComponent({
    classes: "eligibility-table",
    data: disputedSavingsData,
    card: {
      title: {
        text: t("common.financialEligibility.finances.disputedSavings")
      },
      actions: {
        items: [
          {
            href: "/cases/" + caseReference + "/financial-eligibility/change/disputed-savings",
            text: t('common.change')
          }
        ]
      }
    },
    rows: [
      {
        label: t("common.financialEligibility.finances.savingsBalance"),
        key: 'bankBalance'
      },
      {
        label: t("common.financialEligibility.finances.investmentBalance"),
        key: 'investmentBalance'
      },
      {
        label: t("common.financialEligibility.finances.assetBalance"),
        key: 'assetBalance'
      },
      {
        label: t("common.financialEligibility.finances.creditBalance"),
        key: 'creditBalance'
      }
    ]
  }) }}
{% endif %}

{% set disregardsHtml %}
  {% if financialEligibility.disregards and financialEligibility.disregards.length > 0 %}
    <table class="govuk-table">
      <tbody class="govuk-table__body">
        {% for disregard in financialEligibility.disregards %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              {{ t("common.financialDisregards." + disregard) }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p> {{t("common.none")}} </p>
  {% endif %}
{% endset %}

{{ summaryCardComponent({
  classes: "eligibility-table",
  data: {disregardsHtml: disregardsHtml | safe},
  card: {
    title: {
      text: t("common.financialEligibility.finances.disregards")
    },
    actions: {
      items: [
        {
          href: "/cases/" + caseReference + "/financial-eligibility/change/disregards",
          text: t('common.change')
        }
      ]
    }
  },
  rows: [
    {
      label: t("common.financialEligibility.finances.disregardsSelected"),
      key: "disregardsHtml"
    }
  ]
}) }}
