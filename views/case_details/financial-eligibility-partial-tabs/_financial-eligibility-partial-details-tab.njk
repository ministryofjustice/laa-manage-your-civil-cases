{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "components/summaryCardComponent.njk" import summaryCardComponent %}

{% set changeBenefitsLinkHtml %}
  <a class="govuk-link" href="/cases/{{ caseReference }}/financial-eligibility/change/benefits">{{ t('common.change') }}</a>
{% endset %}

{% set under17Text = "Yes" if financialEligibility.isUnder17 else "No" %}
{% set under18RegularPayment = "Yes" if financialEligibility.under18RegularPayment else "No" %}
{% set under18HasValuables = "Yes" if financialEligibility.under18HasValuables else "No" %}
{% set partnerText = "Yes" if financialEligibility.hasPartner else "No" %}
{% set over60Text = "Yes" if financialEligibility.isOver60 else "No"%}
{% set universalCredit = "Yes" if financialEligibility.specificBenefits.universalCredit else "No"%}
{% set pensionCredit = "Yes" if financialEligibility.specificBenefits.pensionCredit else "No"%}
{% set jobSeekers = "Yes" if financialEligibility.specificBenefits.jobSeekers else "No"%}
{% set employmentSupport = "Yes" if financialEligibility.specificBenefits.employmentSupport else "No"%}
{% set incomeSupport = "Yes" if financialEligibility.specificBenefits.incomeSupport else "No"%}

{% set constructedData = {
  under17Text: "Yes" if financialEligibility.isUnder17 else "No",
  under18RegularPayment: "Yes" if financialEligibility.under18RegularPayment else "No",
  under18HasValuables: "Yes" if financialEligibility.under18HasValuables else "No",
  partnerText: "Yes" if financialEligibility.hasPartner else "No",
  over60Text: "Yes" if financialEligibility.isOver60 else "No",
  universalCredit: "Yes" if financialEligibility.specificBenefits.universalCredit else "No",
  pensionCredit: "Yes" if financialEligibility.specificBenefits.pensionCredit else "No",
  jobSeekers: "Yes" if financialEligibility.specificBenefits.jobSeekers else "No",
  employmentSupport: "Yes" if financialEligibility.specificBenefits.employmentSupport else "No",
  incomeSupport: "Yes" if financialEligibility.specificBenefits.incomeSupport else "No"
} %}

{% set partnerAndAgeRows = [
  {
    label: t("common.financialEligibility.details.hasPartner"),
    key: "partnerText"
  },
  {
    label: ( t("common.financialEligibility.details.partnerAge60OrOver") if financialEligibility.hasPartner else t("common.financialEligibility.details.age60OrOver")),
    key: "over60Text"
  }
] %}

{% set rows = [
  {
    label: t("common.financialEligibility.details.age17OrUnder"),
    key: "under17Text"
  }
] %}

{% if financialEligibility.isUnder17 %}
  {% set rows = rows.concat([
    {
      label: t("common.financialEligibility.details.under18RegularPayment"),
      key: "under18RegularPayment"
    }
  ]) %}
  {% if not financialEligibility.under18RegularPayment %}
    {% set rows = rows.concat([ 
      {
        label: t("common.financialEligibility.details.under18HasValuables"),
        key: "under18HasValuables"
      }
    ]) %} 
  {% endif %}
  {% if financialEligibility.under18HasValuables or financialEligibility.under18RegularPayment %}
    {% set rows = rows.concat(partnerAndAgeRows) %}
  {% endif %}
{% else %}
    {% set rows = rows.concat(partnerAndAgeRows) %}
{% endif %}


{{ summaryCardComponent({
  data: constructedData,
  card: {
    title: {
      text: "About you"
    },
    actions: {
      items: [
        {
          href: "/cases/" + caseReference + "/financial-eligibility/change",
          text: t('common.change')
        }
      ]
    }
  },
  rows: rows
}) }}


{% if not financialEligibility.under18passportedBenefits %}
  {{ govukTable({
      caption: "Benefits",
      captionClasses: "govuk-table__caption--m",
      firstCellIsHeader: true,
      classes: "eligibility-table",
      rows: [
        [
          { text: t("common.financialEligibility.details.universalCredit") },
          { text: universalCredit }
        ],
        [
          { text: t("common.financialEligibility.details.incomeSupport") },
          { text: incomeSupport }
        ],
        [
          { text: t("common.financialEligibility.details.incomeBasedJSA") },
          { text: jobSeekers }
        ],
        [
          { text: t("common.financialEligibility.details.pensionCredit") },
          { text: pensionCredit }
        ],
        [
          { text: t("common.financialEligibility.details.employmentSupport") },
          { text: employmentSupport }
        ]
      ]
  }) }}

  <div>{{ changeBenefitsLinkHtml | safe }}</div>
{% endif %}